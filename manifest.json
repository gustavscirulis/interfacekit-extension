{
  "manifest_version": 3,
  "name": "InterfaceKit",
  "version": "0.1.0",
  "description": "Style any page in the browser, then copy the changes as a prompt.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle InterfaceKit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" }
}
